# Alpine-Contributor: Marvin Preuss <marvin@xsteadfastx.org>
# Alpine-Maintainer: Celeste <cielesti@protonmail.com>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=libtermkey
pkgver=0.22
pkgrel=${pkgrel:-0}
pkgdesc="Library for easy processing of keyboard entry from terminal-based programs"
url="https://www.leonerd.org.uk/code/libtermkey"
arch="all"
license="MIT"
depends="unibilium"
depends_dev="unibilium-dev ncurses-dev"
makedepends="$depends_dev libtool perl pkgconf pkgconf-dev"
subpackages="$pkgname-doc $pkgname-dev"
source="https://www.leonerd.org.uk/code/libtermkey/libtermkey-$pkgver.tar.gz
    build-static-lib.patch
    qnx-verbose-tests.patch
    "

build() {
    make PREFIX=/usr
}

check() {
    make test
}

package() {
    make PREFIX=/usr DESTDIR="$pkgdir" install

    install -Dvm644 LICENSE -t "$pkgdir"/system/share/licenses/$pkgname/
}

options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
